# Copy to .env — never commit this file with real values

# PostgreSQL (Neon, Railway, local, etc.)
DB_URL=jdbc:postgresql://localhost:5432/taskdb
DB_USERNAME=postgres
DB_PASSWORD=yourpassword

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Server port (optional, default 8080)
PORT=8080
